Private Sub Form_Delete(CANCEL As Integer)
                   On Error Resume Next
  Dim rst As New ADODB.Recordset
    Forms![BASEKNOW]![Text44] = False
    DoCmd.OpenForm "deleteform", , , , , acDialog
    If Forms![BASEKNOW]![Text44] Then
       rst.Open "SELECT PAY_GETD.N_SERI, PAY_GETD.BANK, PGET_LST.DATE FROM PAY_GETD INNER JOIN PGET_LST ON (PAY_GETD.BANK = PGET_LST.BANK) AND (PAY_GETD.N_SERI = PGET_LST.N_SERI) WHERE (((PAY_GETD.N_SERI)=" & Me.N_SERI & ") AND ((PAY_GETD.BANK)=" & Me.BANK & "))", CurrentProject.Connection, adOpenKeyset, adLockOptimistic
       If rst.RecordCount > 0 Then
         DoCmd.OpenForm "mesageform", , , , , acDialog, " اين چك در خزانه داري مورخ  " & Format(rst.Fields(2), "####/##/##") & " داراي گردش مي باشدو نمي توانيد آن را حذف كنيد...!"
         CANCEL = True
       Else
        Set rst = New ADODB.Recordset
        rst.Open "SELECT     dbo.DEED_DTL.N_S FROM         dbo.PAY_GETD INNER JOIN  dbo.DEED_DTL ON dbo.PAY_GETD.N_SERI = dbo.DEED_DTL.N_SERI AND dbo.PAY_GETD.BANK = dbo.DEED_DTL.BANK WHERE (dbo.PAY_GETD.N_SERI = " & Me.N_SERI & ") And (dbo.PAY_GETD.BANK = " & Me.BANK & ") GROUP BY dbo.DEED_DTL.N_S", CurrentProject.Connection, adOpenKeyset, adLockOptimistic
        If rst.RecordCount > 0 Then
          DoCmd.OpenForm "mesageform", , , , , acDialog, "  اين چك در سند شماره " & rst.Fields("N_S") & " داراي گردش مي باشدو نمي توانيد آن را حذف كنيد...!"
          CANCEL = True
        Else
              Me.N_KOL = 911
              Me.N_MOIN = 1
              Me.N_TAF = 1
              Me.N_KOL2 = Null
              Me.N_MOIN2 = Null
              Me.N_TAF2 = Null
              Me.N_KOL3 = Null
              Me.N_MOIN3 = Null
              Me.N_TAF3 = Null
              Me.N_KOL.Requery
              Me.N_MOIN.Requery
              Me.N_TAF.Requery
              Me.N_KOL2.Requery
              Me.N_MOIN2.Requery
              Me.N_TAF2.Requery
              Me.N_KOL3.Requery
              Me.N_MOIN3.Requery
              Me.N_TAF3.Requery
              DoCmd.OpenForm "mesageform", , , , , acDialog, "چك بصورت مجازي از دفتر چك حذف گرديد"
        End If
       End If
        CANCEL = True
    Else
        CANCEL = True
    End If
End Sub
Private Sub Form_Load()
                   On Error Resume Next
  If Me.RecordsetClone.RecordCount > 0 Then
    DoCmd.GoToRecord acDataForm, Me.NAME, acLast
    Me.N_SERI.SetFocus
  End If
  Call SETSECURITY(Me.NAME, "CHEKD", 3)
End Sub

Private Sub Form_Open(CANCEL As Integer)
    Forms![BASEKNOW]![hhwin] = Me.hWnd
End Sub

Private Sub Label58_DblClick(CANCEL As Integer)
    Dim rst As New ADODB.Recordset
    rst.Open "SELECT     N_S FROM dbo.DEED_DTL WHERE     (HES = '" & Forms![BASEKNOW]![ADA] & "' OR HES = '" & Forms![BASEKNOW]![ADV] & "' ) AND (BES > 0) AND (BANK = " & Me.BANK & ") AND (N_SERI = " & Me.N_SERI & ")", CurrentProject.Connection, adOpenKeyset, adLockOptimistic
    If rst.RecordCount > 0 Then
        DoCmd.OpenForm "mesageform", , , , , acDialog, "اين چك در سند شماره " & rst.Fields("n_s") & " داراي گردش بستانكار است و نمي توانيد حساب واگذاري يا برگشتي يا وصولي آن را حذف نماييد"
    Else
        If Me.N_KOL <> Forms![BASEKNOW]![BANKHA] Then
            Me.N_KOL = Null
            Me.N_MOIN = Null
            Me.N_TAF = Null
        End If
        Me.N_KOL2 = Null
        Me.N_MOIN2 = Null
        Me.N_TAF2 = Null
        Me.N_KOL3 = Null
        Me.N_MOIN3 = Null
        Me.N_TAF3 = Null
        Me.N_S = Null
    End If
End Sub
