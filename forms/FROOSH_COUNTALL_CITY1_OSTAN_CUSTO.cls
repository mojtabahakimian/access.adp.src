Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database
Private Sub Form_Error(DataErr As Integer, Response As Integer)
                    On Error Resume Next: errdetector (DataErr)
   Response = acDataErrContinue: DoCmd.RunMacro "stop"
End Sub
Private Sub Form_Open(CANCEL As Integer)
                   On Error Resume Next
  If Me.OpenArgs <> "" Then
       Me.RecordSource = "SELECT SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHKF) AS MEGHF, SUM(FROOSH_COUNTALL_CITY_N_FANI.MABK) AS MABKK, SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHkK) AS MEGHk, FROOSH_COUNTALL_CITY_N_FANI.OSCO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO AS CUSTNO, TCOD_OSTAN.OSNAME, CUST_HESAB.NAME FROM FROOSH_COUNTALL_CITY_N_FANI(" & Forms![F_MENU_DATE]![DT1] & "," & Forms![F_MENU_DATE]![DT2] & ") FROOSH_COUNTALL_CITY_N_FANI INNER JOIN TCOD_OSTAN ON FROOSH_COUNTALL_CITY_N_FANI.OSCO = TCOD_OSTAN.OSCODE INNER JOIN CUST_HESAB ON FROOSH_COUNTALL_CITY_N_FANI.CUST_NO = CUST_HESAB.hes  WHERE FROOSH_COUNTALL_CITY_N_FANI.OSCO = " & Me.OpenArgs & " GROUP BY FROOSH_COUNTALL_CITY_N_FANI.OSCO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO, TCOD_OSTAN.OSNAME, CUST_HESAB.NAME ORDER BY SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHKF)"
  Else
       Me.RecordSource = "SELECT SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHKF) AS MEGHF, SUM(FROOSH_COUNTALL_CITY_N_FANI.MABK) AS MABKK, SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHkK) AS MEGHk, FROOSH_COUNTALL_CITY_N_FANI.OSCO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO AS CUSTNO, TCOD_OSTAN.OSNAME, CUST_HESAB.NAME FROM FROOSH_COUNTALL_CITY_N_FANI(" & Forms![F_MENU_DATE]![DT1] & "," & Forms![F_MENU_DATE]![DT2] & ") FROOSH_COUNTALL_CITY_N_FANI INNER JOIN TCOD_OSTAN ON FROOSH_COUNTALL_CITY_N_FANI.OSCO = TCOD_OSTAN.OSCODE INNER JOIN CUST_HESAB ON FROOSH_COUNTALL_CITY_N_FANI.CUST_NO = CUST_HESAB.hes  GROUP BY FROOSH_COUNTALL_CITY_N_FANI.OSCO, FROOSH_COUNTALL_CITY_N_FANI.CUST_NO, TCOD_OSTAN.OSNAME, CUST_HESAB.NAME ORDER BY SUM(FROOSH_COUNTALL_CITY_N_FANI.MEGHKF)"
  End If
   DoCmd.Maximize: Forms![BASEKNOW]![hhwin] = Me.hWnd
End Sub
