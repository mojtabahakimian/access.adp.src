Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database

Private Sub Form_Open(CANCEL As Integer)
  ' Prevent duplicate visitor invoice rows from inflating customer totals.
  Me.RecordSource = "SELECT VI.CUST_NO, SUM(VI.mabpur) AS mabpur, SUM(JAMFACTVISIT.MABL_K) AS MABL_K, SUM(JAMFACTVISIT.MEGHk) AS MEGHk, SUM(JAMFACTVISIT.MEGH_MAR) AS MEGH_MAR, SUM(JAMFACTVISIT.N_MOIN) AS TAKHF, SUM(JAMFACTVISIT.IMBAA) AS MBAA, " & _
                    "SUM(JAMFACTVISIT.MABMAR) AS MABMAR, SUM(JAMFACTVISIT.GHABEL) AS GHABEL, dbo.CUST_HESAB.NAME AS VISNAME, dbo.CUST_HESAB.TOZIH, CUST_HESAB_1.NAME AS CUSTNAME, CUST_HESAB_1.ADDRESS, CUST_HESAB_1.TEL, JAMFACTVISIT.CUST_NO AS CUSTOMER, COUNT(*) AS TDF, " & _
                    "CUST_HESAB_1.MOBILE, CUST_HESAB_1.ROUTE_NAME, CUST_HESAB_1.OSTANID, CUST_HESAB_1.SHAHRID FROM (SELECT CUST_NO, NUMBER, TAG, SUM(mabpur) AS mabpur FROM (SELECT DISTINCT CUST_NO, NUMBER, TAG, mabpur FROM dbo.VISITOR_DTLO) AS VD GROUP BY CUST_NO, NUMBER, TAG) AS VI " & _
                    "INNER JOIN dbo.CUST_HESAB ON VI.CUST_NO = dbo.CUST_HESAB.hes INNER JOIN dbo.JAMFACTVISIT(" & Forms![F_MENU_DATE_VISIT]![DT1] & "," & Forms![F_MENU_DATE_VISIT]![DT2] & _
                    " ) JAMFACTVISIT ON VI.NUMBER = JAMFACTVISIT.NUMBER AND VI.TAG = JAMFACTVISIT.TAG INNER JOIN dbo.CUST_HESAB CUST_HESAB_1 ON JAMFACTVISIT.CUST_NO = CUST_HESAB_1.hes GROUP BY VI.CUST_NO, dbo.CUST_HESAB.NAME, dbo.CUST_HESAB.TOZIH, CUST_HESAB_1.NAME, CUST_HESAB_1.ADDRESS, CUST_HESAB_1.TEL, JAMFACTVISIT.CUST_NO, CUST_HESAB_1.MOBILE, CUST_HESAB_1.ROUTE_NAME, CUST_HESAB_1.OSTANID, CUST_HESAB_1.SHAHRID"
End Sub
