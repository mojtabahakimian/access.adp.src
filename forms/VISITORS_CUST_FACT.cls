Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database

Private Sub Form_Open(CANCEL As Integer)
  Me.RecordSource = "SELECT VI.CUST_NO, SUM(VI.mabpur) AS mabpur, SUM(JAMFACTVISIT.MABL_K) AS MABL_K, SUM(JAMFACTVISIT.MEGHk) AS MEGHk, SUM(JAMFACTVISIT.MEGH_MAR) AS MEGH_MAR, SUM(JAMFACTVISIT.N_MOIN) AS TAKHF, SUM(JAMFACTVISIT.IMBAA) AS MBAA, SUM(JAMFACTVISIT.MABMAR) AS MABMAR, SUM(JAMFACTVISIT.GHABEL) AS GHABEL, dbo.CUST_HESAB.NAME AS VISNAME, dbo.CUST_HESAB.TOZIH, CUST_HESAB_1.NAME AS CUSTNAME, CUST_HESAB_1.ADDRESS, CUST_HESAB_1.TEL, JAMFACTVISIT.CUST_NO AS CUSTOMER, JAMFACTVISIT.NUMBER, JAMFACTVISIT.DATE_N, CUST_HESAB_1.MOBILE FROM (SELECT CUST_NO, NUMBER, TAG, SUM(mabpur) AS mabpur FROM dbo.VISITOR_DTLO GROUP BY CUST_NO, NUMBER, TAG) AS VI INNER JOIN dbo.CUST_HESAB ON VI.CUST_NO = dbo.CUST_HESAB.hes INNER JOIN " & _
                    " dbo.JAMFACTVISIT(" & Forms![F_MENU_DATE_VISIT]![DT1] & "," & Forms![F_MENU_DATE_VISIT]![DT2] & " ) JAMFACTVISIT ON VI.NUMBER = JAMFACTVISIT.NUMBER AND VI.TAG = JAMFACTVISIT.TAG INNER JOIN dbo.CUST_HESAB CUST_HESAB_1 ON JAMFACTVISIT.CUST_NO = CUST_HESAB_1.hes GROUP BY VI.CUST_NO, dbo.CUST_HESAB.NAME, dbo.CUST_HESAB.TOZIH, CUST_HESAB_1.NAME, CUST_HESAB_1.ADDRESS, CUST_HESAB_1.TEL, JAMFACTVISIT.CUST_NO, JAMFACTVISIT.NUMBER, JAMFACTVISIT.DATE_N, CUST_HESAB_1.MOBILE"
End Sub
