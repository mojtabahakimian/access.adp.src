Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database

Private Sub Report_Open(CANCEL As Integer)
    Me.RecordSource = "SELECT     dbo.PAY_GETD.*, dbo.CUST_HESAB.NAME AS CUSTNAM, TCOD_BANKS.NAMES + N'-' + ISNULL(PAY_GETD.SHOBEH, N' ') AS BANKNAME FROM dbo.HEAD_LST INNER JOIN   dbo.PAY_GETD ON dbo.HEAD_LST.TAG = dbo.PAY_GETD.TAG AND dbo.HEAD_LST.NUMBER = dbo.PAY_GETD.NUMBER INNER JOIN  dbo.CUST_HESAB ON dbo.HEAD_LST.CUST_NO = dbo.CUST_HESAB.hes INNER JOIN  dbo.TCOD_BANKS ON dbo.PAY_GETD.BANK = dbo.TCOD_BANKS.CODE WHERE     (HEAD_LST.TAG = 2 OR  HEAD_LST.TAG = 14)  AND (HEAD_LST.DATE_N BETWEEN " & Forms![F_MENU_GOZARESH_FROOSH]![DT1] & " AND    " & Forms![F_MENU_GOZARESH_FROOSH]![DT2] & ") AND (HEAD_LST.DEPATMAN = " & Forms![F_MENU_GOZARESH_FROOSH]![DEPART] & ") AND   (CAST(HEAD_LST.SHIFT AS NVARCHAR) LIKE N'" & Forms![F_MENU_GOZARESH_FROOSH]![SSHIFT] & "') AND  (HEAD_LST.USER_NAME LIKE N'" & Forms![F_MENU_GOZARESH_FROOSH]![USERR] & "')"
End Sub
