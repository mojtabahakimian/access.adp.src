Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database

Private Sub Report_Open(CANCEL As Integer)
   Me.RecordSource = "SELECT     TOP 100 PERCENT GUSER_FACT_PERDEPART_SUB.NUMBER, GUSER_FACT_PERDEPART_SUB.SMAB + GUSER_FACT_PERDEPART_SUB.MBAA + GUSER_FACT_PERDEPART_SUB.HAZ - GUSER_FACT_PERDEPART_SUB.TAKHFIF AS SMAB," & _
                     " GUSER_FACT_PERDEPART_SUB.TAKHFIF, GUSER_FACT_PERDEPART_SUB.MBAA, GUSER_FACT_PERDEPART_SUB.MABL_VAR, GUSER_FACT_PERDEPART_SUB.MABL_HAV, GUSER_FACT_PERDEPART_SUB.M_NAGHD, GUSER_FACT_PERDEPART_SUB.HAZ, GUSER_FACT_PERDEPART_SUB.CHK, dbo.CUST_HESAB.NAME, (GUSER_FACT_PERDEPART_SUB.smab + GUSER_FACT_PERDEPART_SUB.MBAA - GUSER_FACT_PERDEPART_SUB.TAKHFIF - GUSER_FACT_PERDEPART_SUB.MABL_VAR - GUSER_FACT_PERDEPART_SUB.MABL_HAV - GUSER_FACT_PERDEPART_SUB.CHK + GUSER_FACT_PERDEPART_SUB.HAZ - GUSER_FACT_PERDEPART_SUB.M_NAGHD)* -1  AS MAND  FROM         dbo.GUSER_FACT_PERDEPART_SUB(" & Forms![F_MENU_GOZARESH_FROOSH]![DT1] & ", " & Forms![F_MENU_GOZARESH_FROOSH]![DT2] & ", " & Forms![F_MENU_GOZARESH_FROOSH]![DEPART] & ", '" & Forms![F_MENU_GOZARESH_FROOSH]![SSHIFT] & "', '" & Forms![F_MENU_GOZARESH_FROOSH]![USERR] & "') GUSER_FACT_PERDEPART_SUB INNER JOIN " & _
                     " dbo.HEAD_LST ON GUSER_FACT_PERDEPART_SUB.NUMBER = dbo.HEAD_LST.NUMBER INNER JOIN  dbo.CUST_HESAB ON dbo.HEAD_LST.CUST_NO = dbo.CUST_HESAB.hes   WHERE     (dbo.HEAD_LST.TAG = 2) AND  (GUSER_FACT_PERDEPART_SUB.SMAB + GUSER_FACT_PERDEPART_SUB.MBAA - GUSER_FACT_PERDEPART_SUB.TAKHFIF - GUSER_FACT_PERDEPART_SUB.MABL_VAR  - GUSER_FACT_PERDEPART_SUB.MABL_HAV - GUSER_FACT_PERDEPART_SUB.CHK + GUSER_FACT_PERDEPART_SUB.HAZ - GUSER_FACT_PERDEPART_SUB.M_NAGHD < 0) ORDER BY GUSER_FACT_PERDEPART_SUB.NUMBER"
 End Sub
